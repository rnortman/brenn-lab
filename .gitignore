# Globs here are deliberately wide. An uncovered artifact is one `git add .` away
# from becoming tracked content that has to be scrubbed back out again.

# Bazel's convenience symlinks, any output base or cache placed inside the tree,
# and per-developer flag files. MODULE.bazel.lock and requirements_lock.txt are
# tracked; these are not.
bazel-*
.bazel-*
/.bazelrc.user

# Python bytecode, virtual environments and tool caches. Bazel is the build;
# a stray interpreter or editor integration still produces these.
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Capture and run artifacts. Recordings never enter the repository; a
# synthetic fixture is re-included by its own named `!` line. A run directory
# hides itself with a `.gitignore` of its own; these globs catch a stray file.
# Audio.
*.framelog
*.wav
*.flac
*.ogg
*.opus
*.mp3
*.m4a
*.aac
*.pcm
*.raw
*.w64
*.caf
# Arrays and containers a run may write.
*.npy
*.npz
*.h5
*.hdf5
*.parquet
*.mcap
*.pcap
# Logs and streams.
*.log
*.jsonl
# The recorder transcripts the stand-in replays: event lines, no audio.
!/brenn_lab/testing/transcripts/authored/after_terminal.jsonl
!/brenn_lab/testing/transcripts/authored/channels_mismatch.jsonl
!/brenn_lab/testing/transcripts/authored/exit_after_failed.jsonl
!/brenn_lab/testing/transcripts/authored/exit_after_stopped.jsonl
!/brenn_lab/testing/transcripts/authored/exits_at_stop.jsonl
!/brenn_lab/testing/transcripts/authored/exits_mid_capture.jsonl
!/brenn_lab/testing/transcripts/authored/gap_first.jsonl
!/brenn_lab/testing/transcripts/authored/late.jsonl
!/brenn_lab/testing/transcripts/authored/not_json.jsonl
!/brenn_lab/testing/transcripts/authored/second_started.jsonl
!/brenn_lab/testing/transcripts/authored/silent.jsonl
!/brenn_lab/testing/transcripts/authored/stops_unasked.jsonl
!/brenn_lab/testing/transcripts/authored/stream_died.jsonl
!/brenn_lab/testing/transcripts/authored/unknown_event.jsonl
!/brenn_lab/testing/transcripts/authored/unknown_reason.jsonl
!/brenn_lab/testing/transcripts/authored/write_stalled.jsonl
!/brenn_lab/testing/transcripts/recorded/clean.jsonl
!/brenn_lab/testing/transcripts/recorded/loss.jsonl
!/brenn_lab/testing/transcripts/recorded/no_card.jsonl
# A speech clip whose licence allows redistribution; README.md beside it.
!/brenn_lab/testing/speech/arctic_a0001.wav

# Per-machine tool configuration that names local paths.
*.local.toml
.local/

# Personal Claude Code settings (settings.json is shared).
.claude/settings.local.json

# Local secret-scanner rule overrides. Never content in this repo.
.gitleaks.local.toml

# Per-checkout agent context (CLAUDE.md and AGENTS.md are shared).
CLAUDE.local.md

# Editor and OS noise.
*.swp
*~
.vscode/
.idea/
.DS_Store

# allthechanges reads every entry in the fragment directories whose name does
# not start with a dot, so git sees every such entry too: a fragment the globs
# above would hide (a `bazel-…` slug) is committed, and a stray file shows in
# `git status` instead of being gathered unseen.
!/changelog.d/[!.]*
!/todo.d/[!.]*
