"""brenn-lab's Bazel module graph.

Every tool and interpreter here is pinned and fetched by checksum, except
brenn-pod's crates, which are pinned by commit and fetched with the host's git;
so on linux x86_64 a build needs nothing from the host but bazelisk and git. On
linux aarch64 the C toolchain has no pinned sysroot and links against the
host's, the recorder's libasound included. Python dependencies are not declared
here: `requirements.in` names them and `requirements_lock.txt` pins them with
hashes; `make repin` regenerates that lock and the five crate locks. The Rust
and LLVM toolchains build the two gate tools, brenn-scrub and allthechanges,
the two programs pinned from brenn-pod, pod-capture and frame-log, and the
repository's own Rust, the sink client.
"""

module(name = "brenn_lab")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "rules_mypy", version = "0.41.0", dev_dependency = True)

# --- Python ---------------------------------------------------------------
# The one interpreter version. mypy.ini, ruff.toml and tools/mypy/BUILD.bazel
# state it too; //tools/pins:pins_test holds the four equal.
PYTHON_VERSION = "3.14"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

# uv: only the lock rule uses it. rules_python registers its toolchains, but
# the root module must name a version; checksums come from the release's
# dist-manifest.json.
uv = use_extension("@rules_python//python/uv:uv.bzl", "uv")
uv.configure(version = "0.13.7")

# A directory holding py_* targets is a package only if it carries its own
# __init__.py; rules_python otherwise creates them in runfiles and warns.
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

# Not named `pypi`: rules_python reserves that hub name.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi_lab",
    python_version = PYTHON_VERSION,
    requirements_lock = "//:requirements_lock.txt",
    # The default is the host platform only.
    target_platforms = [
        "linux_aarch64",
        "linux_x86_64",
    ],
)
use_repo(pip, "pypi_lab")

# --- ruff -----------------------------------------------------------------
# The static musl release builds, one per exec CPU. Each tarball holds one
# directory, ruff-<triple>/, with the single `ruff` executable in it.
RUFF_VERSION = "0.17.4"

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "ruff_x86_64_linux",
    build_file_content = 'exports_files(["ruff"])',
    sha256 = "d1d6ec9ce1ce0c01e23532a157a677077ba1f82f7cd2cde6f0bd75e65f85df93",
    strip_prefix = "ruff-x86_64-unknown-linux-musl",
    url = "https://github.com/astral-sh/ruff/releases/download/" + RUFF_VERSION +
          "/ruff-x86_64-unknown-linux-musl.tar.gz",
)

http_archive(
    name = "ruff_aarch64_linux",
    build_file_content = 'exports_files(["ruff"])',
    sha256 = "71491cf93242d1bde15dcc628fd105f27c54738bef6b94050b9363ba6795f97e",
    strip_prefix = "ruff-aarch64-unknown-linux-musl",
    url = "https://github.com/astral-sh/ruff/releases/download/" + RUFF_VERSION +
          "/ruff-aarch64-unknown-linux-musl.tar.gz",
)

# --- Rust toolchain -------------------------------------------------------
# brenn-scrub publishes no binaries, so the gate builds it from its crate, and
# allthechanges the same way; brenn-pod's recorder and reader are built from
# their crates at a pinned commit; the sink client is this repository's own.
RUST_VERSION = "1.98.0"

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = [RUST_VERSION],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# --- Gate tool crates -----------------------------------------------------
# brenn-scrub, from crates.io, in a hub of its own. `repositories` is
# required, not optional: a crate.spec without it applies to every hub in the
# module. Pinned by the two files under tools/scrub; `make repin` re-renders
# every hub (CARGO_BAZEL_REPIN applies to every hub this extension declares).
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "brenn-scrub",
    repositories = ["scrub_crates"],
    version = "=0.2.0",
)
crate.annotation(
    crate = "brenn-scrub",
    gen_binaries = ["brenn-scrub"],
    repositories = ["scrub_crates"],
)
crate.from_specs(
    name = "scrub_crates",
    cargo_lockfile = "//tools/scrub:Cargo.lock",
    lockfile = "//tools/scrub:cargo-bazel-lock.json",
)

# allthechanges, the changelog and TODO fragment tool, from crates.io, in a hub
# of its own for the same reason. Pinned by the two files under
# tools/allthechanges.
crate.spec(
    package = "allthechanges",
    repositories = ["allthechanges_crates"],
    version = "=0.3.0",
)
crate.annotation(
    crate = "allthechanges",
    gen_binaries = ["allthechanges"],
    repositories = ["allthechanges_crates"],
)
crate.from_specs(
    name = "allthechanges_crates",
    cargo_lockfile = "//tools/allthechanges:Cargo.lock",
    lockfile = "//tools/allthechanges:cargo-bazel-lock.json",
)

# TODO(brenn-bindings-revision-not-on-remote): brenn's Python binding will be
# built from a brenn commit pinned here, which has to be on brenn's remote
# first.
# TODO(off-machine-bus-role-needs-write-deadline): the brenn commit this file
# will pin must have the attach client's write deadline before any role is
# driven over the bus to a server on another machine.

# --- brenn-pod's programs -------------------------------------------------
# The recorder, pod-capture, which the runner carries for a capture role whose
# machine names `pod_capture = { pinned = true }`, and the reader, frame-log.
# Each is a hub of its own on the same extension, pinned by the two files under
# tools/brenn_pod/<program>. Unlike every other pin here they are fetched by
# commit, with the host's git, and not by checksum. BRENN_POD_COMMIT is the one
# statement of the revision; //tools/pins:pins_test holds every use of it.
# TODO(pinned-brenn-pod-revision-not-on-main): the commit is the head of a
# branch on brenn-pod's remote, not on its main.
BRENN_POD_COMMIT = "5a55610ba6e84fe484291ed83a442bccbfd853f2"

BRENN_POD_REMOTE = "https://github.com/rnortman/brenn-pod.git"

crate.spec(
    git = BRENN_POD_REMOTE,
    package = "pod-capture",
    repositories = ["pod_capture_crates"],
    rev = BRENN_POD_COMMIT,
)
crate.annotation(
    crate = "pod-capture",
    gen_binaries = ["pod-capture"],
    repositories = ["pod_capture_crates"],
)

# build-id's build script stamps the commit declared in BRENN_POD_BUILD_COMMIT
# and, with no checkout of brenn-pod around the crate, starts no program.
crate.annotation(
    build_script_env = {
        "BRENN_POD_BUILD_COMMIT": BRENN_POD_COMMIT,
    },
    crate = "build-id",
    repositories = ["pod_capture_crates"],
)

# alsa-sys's build script reads the host's pkg-config, which puts the host's
# library directory ahead of the pinned sysroot and breaks the link. Off; the
# library is found through the C toolchain's sysroot.
crate.annotation(
    crate = "alsa-sys",
    gen_build_script = "off",
    repositories = ["pod_capture_crates"],
    rustc_flags = ["-ldylib=asound"],
)
crate.from_specs(
    name = "pod_capture_crates",
    cargo_lockfile = "//tools/brenn_pod/pod_capture:Cargo.lock",
    lockfile = "//tools/brenn_pod/pod_capture:cargo-bazel-lock.json",
)
crate.spec(
    git = BRENN_POD_REMOTE,
    package = "frame-log",
    repositories = ["frame_log_crates"],
    rev = BRENN_POD_COMMIT,
)
crate.annotation(
    crate = "frame-log",
    gen_binaries = ["frame-log"],
    repositories = ["frame_log_crates"],
)
crate.from_specs(
    name = "frame_log_crates",
    cargo_lockfile = "//tools/brenn_pod/frame_log:Cargo.lock",
    lockfile = "//tools/brenn_pod/frame_log:cargo-bazel-lock.json",
)

# --- The sink client's crates ---------------------------------------------
# The PulseAudio native protocol, pure Rust, and the JSON the client speaks to
# the role, in a hub of their own for the repository's own Rust: the sink
# client under brenn_lab/playback/pulse_client, pinned by the two files there.
# PULSEAUDIO_VERSION is restated in that package's BUILD.bazel, which reports
# it; //tools/pins:pins_test holds the two equal.
PULSEAUDIO_VERSION = "0.3.2"

crate.spec(
    package = "pulseaudio",
    repositories = ["pulse_client_crates"],
    version = "=" + PULSEAUDIO_VERSION,
)
crate.spec(
    features = ["derive"],
    package = "serde",
    repositories = ["pulse_client_crates"],
    version = "=1.0.229",
)
crate.spec(
    package = "serde_json",
    repositories = ["pulse_client_crates"],
    version = "=1.0.154",
)
crate.from_specs(
    name = "pulse_client_crates",
    cargo_lockfile = "//brenn_lab/playback/pulse_client:Cargo.lock",
    lockfile = "//brenn_lab/playback/pulse_client:cargo-bazel-lock.json",
)
use_repo(
    crate,
    "allthechanges_crates",
    "frame_log_crates",
    "pod_capture_crates",
    "pulse_client_crates",
    "scrub_crates",
)

# --- gitleaks -------------------------------------------------------------
# The release brenn-scrub 0.2.0 pins. brenn-scrub refuses any other gitleaks
# version, so this moves together with the crate.spec above.
GITLEAKS_VERSION = "8.30.0"

GITLEAKS_SHA256_X86_64 = "79a3ab579b53f71efd634f3aaf7e04a0fa0cf206b7ed434638d1547a2470a66e"

GITLEAKS_SHA256_AARCH64 = "b4cbbb6ddf7d1b2a603088cd03a4e3f7ce48ee7fd449b51f7de6ee2906f5fa2f"

http_archive(
    name = "gitleaks_x86_64_linux",
    build_file = "//tools/scrub:gitleaks.BUILD.bazel",
    sha256 = GITLEAKS_SHA256_X86_64,
    url = "https://github.com/gitleaks/gitleaks/releases/download/v" + GITLEAKS_VERSION +
          "/gitleaks_" + GITLEAKS_VERSION + "_linux_x64.tar.gz",
)

http_archive(
    name = "gitleaks_aarch64_linux",
    build_file = "//tools/scrub:gitleaks.BUILD.bazel",
    sha256 = GITLEAKS_SHA256_AARCH64,
    url = "https://github.com/gitleaks/gitleaks/releases/download/v" + GITLEAKS_VERSION +
          "/gitleaks_" + GITLEAKS_VERSION + "_linux_arm64.tar.gz",
)

# --- Hermetic C toolchain -------------------------------------------------
# rustc links through a C toolchain, and Bazel's auto-detected host gcc puts
# machine-specific facts into every action key. A pinned LLVM release plus a
# pinned Debian sysroot makes the build byte-identical across machines and
# keeps the host compiler out of it. The sysroot is Chromium's bullseye amd64
# sysroot (glibc 2.31): binaries link against it and run on any newer glibc.
# It is pinned for linux-x86_64 only; on a linux-aarch64 host the LLVM
# toolchain falls back to the host's own headers and libc, and the recorder's
# link takes the host's libasound, from the host's ALSA development files.
# TODO(aarch64-gate-tools-link-host-libc): pin a sysroot for linux-aarch64
# too, so the gate tools and brenn-pod's programs build there without the
# host's libc or ALSA development files.
# `dev_dependency`: registration is unconditional, and a module depending on
# this one brings its own toolchain.
bazel_dep(name = "toolchains_llvm", version = "1.12.0", dev_dependency = True)

sysroot = use_repo_rule("@toolchains_llvm//toolchain:sysroot.bzl", "sysroot")

sysroot(
    name = "org_chromium_sysroot_linux_x64",
    dev_dependency = True,
    sha256 = "52d61d4446ffebfaa3dda2cd02da4ab4876ff237853f46d273e7f9b666652e1d",
    # Chromium serves each sysroot tarball under its own sha256, no filename.
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/52d61d4446ffebfaa3dda2cd02da4ab4876ff237853f46d273e7f9b666652e1d"],
)

llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)
llvm.toolchain(
    name = "llvm_toolchain",
    cxx_include_layout = {"linux-x86_64": "debian"},
    llvm_version = "23.1.4",
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@org_chromium_sysroot_linux_x64//sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)
