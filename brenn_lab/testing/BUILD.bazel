load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/pytest:defs.bzl", "py_pytest_test")

# The stand-in recorder, the transcripts it replays, and the helpers tests
# read them with. Test-only: nothing that ships depends on this package.

TRANSCRIPTS = [
    "transcripts/README.md",
    "transcripts/authored/after_terminal.jsonl",
    "transcripts/authored/channels_mismatch.jsonl",
    "transcripts/authored/exit_after_failed.jsonl",
    "transcripts/authored/exit_after_failed.replay.toml",
    "transcripts/authored/exit_after_stopped.jsonl",
    "transcripts/authored/exit_after_stopped.replay.toml",
    "transcripts/authored/exits_at_stop.jsonl",
    "transcripts/authored/exits_mid_capture.jsonl",
    "transcripts/authored/exits_mid_capture.replay.toml",
    "transcripts/authored/gap_first.jsonl",
    "transcripts/authored/late.jsonl",
    "transcripts/authored/not_json.jsonl",
    "transcripts/authored/second_started.jsonl",
    "transcripts/authored/silent.jsonl",
    "transcripts/authored/stops_unasked.jsonl",
    "transcripts/authored/stops_unasked.replay.toml",
    "transcripts/authored/stream_died.jsonl",
    "transcripts/authored/unknown_event.jsonl",
    "transcripts/authored/unknown_reason.jsonl",
    "transcripts/authored/write_stalled.jsonl",
    "transcripts/authored/write_stalled.replay.toml",
    "transcripts/recorded/clean.jsonl",
    "transcripts/recorded/loss.jsonl",
    "transcripts/recorded/no_card.jsonl",
]

# The README names the brenn-pod commit the recorded transcripts were taken
# at; //tools/pins holds it to the pin.
exports_files(
    ["transcripts/README.md"],
    visibility = ["//tools/pins:__pkg__"],
)

filegroup(
    name = "transcripts",
    testonly = True,
    srcs = TRANSCRIPTS,
)

py_library(
    name = "transcript_files",
    testonly = True,
    srcs = ["transcript_files.py"],
    data = [":transcripts"],
    visibility = ["//brenn_lab:__subpackages__"],
    deps = ["//brenn_lab"],
)

py_library(
    name = "fake_output",
    testonly = True,
    srcs = ["fake_output.py"],
    visibility = ["//brenn_lab:__subpackages__"],
    deps = ["//brenn_lab"],
)

py_library(
    name = "signals",
    testonly = True,
    srcs = ["signals.py"],
    visibility = ["//brenn_lab:__subpackages__"],
)

py_library(
    name = "scenes",
    testonly = True,
    srcs = ["scenes.py"],
    visibility = ["//brenn_lab:__subpackages__"],
    deps = [
        "//brenn_lab",
        "@pypi_lab//numpy",
    ],
)

py_pytest_test(
    name = "signals_test",
    size = "small",
    srcs = ["signals_test.py"],
    deps = [
        ":signals",
        "//brenn_lab",
    ],
)

py_library(
    name = "lab_driver",
    testonly = True,
    srcs = ["lab_driver.py"],
    visibility = ["//brenn_lab:__subpackages__"],
    deps = [":transcript_files"],
)

py_binary(
    name = "export_stand_in",
    testonly = True,
    srcs = ["export_stand_in.py"],
    visibility = ["//brenn_lab:__subpackages__"],
)

py_binary(
    name = "stand_in",
    testonly = True,
    srcs = ["stand_in.py"],
    visibility = ["//brenn_lab:__subpackages__"],
    deps = [":transcript_files"],
)
