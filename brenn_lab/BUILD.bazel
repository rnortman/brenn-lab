load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/pytest:defs.bzl", "py_pytest_test")

# Every source is listed by name, with no glob: a new file reaches a target
# only through a tracked change to this file.

py_library(
    name = "brenn_lab",
    srcs = [
        "__init__.py",
        "account.py",
        "buildinfo.py",
        "capture/__init__.py",
        "capture/account.py",
        "capture/device.py",
        "capture/messages.py",
        "capture/pod_capture.py",
        "capture/role.py",
        "config_table.py",
        "data.py",
        "labconfig.py",
        "marker.py",
        "pinned.py",
        "place.py",
        "playback/__init__.py",
        "playback/account.py",
        "playback/alsa.py",
        "playback/device.py",
        "playback/limits.py",
        "playback/messages.py",
        "playback/output.py",
        "playback/pulse.py",
        "playback/role.py",
        "playback/source.py",
        "roles.py",
        "rundir.py",
        "runner.py",
        "script.py",
        "sound.py",
    ],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = ["@rules_python//python/runfiles"],
)

# Alignment, apart from the rest so that only what imports it carries numpy.
py_library(
    name = "align",
    srcs = [
        "align/__init__.py",
        "align/capture.py",
        "align/report.py",
        "align/search.py",
    ],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        ":brenn_lab",
        "@pypi_lab//numpy",
    ],
)

# The assessment of a run, made in alignment's pass.
py_library(
    name = "assess",
    srcs = [
        "assess/__init__.py",
        "assess/measure.py",
        "assess/report.py",
    ],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        ":align",
        ":brenn_lab",
    ],
)

# The entry point's module, a library so that a test can call its functions in
# its own process.
py_library(
    name = "cli",
    srcs = ["cli.py"],
    imports = [".."],
    deps = [
        ":align",
        ":assess",
        ":brenn_lab",
        "@rules_python//python/runfiles",
    ],
)

# The runner: `bazel run //brenn_lab:lab -- dry-run|run|mark|align|assess ...`.
# It carries the pinned recorder, which a machine's
# `pod_capture = { pinned = true }` names, the sink client, which
# `pulse_client = { pinned = true }` names, and the pinned reader, which
# `align`, `assess` and a run's closing assessment run.
py_binary(
    name = "lab",
    srcs = ["cli.py"],
    data = [
        "//brenn_lab/playback/pulse_client:pulse-client",
        "//tools/brenn_pod:frame-log",
        "//tools/brenn_pod:pod-capture",
        "//tools/buildinfo:build_info",
    ],
    main = "cli.py",
    visibility = ["//visibility:public"],
    deps = [
        ":align",
        ":assess",
        ":brenn_lab",
        ":cli",
        "@rules_python//python/runfiles",
    ],
)

