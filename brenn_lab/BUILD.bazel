load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/pytest:defs.bzl", "py_pytest_test")

# Every source is listed by name, with no glob: a new file reaches a target
# only through a tracked change to this file.

py_library(
    name = "brenn_lab",
    srcs = [
        "__init__.py",
        "buildinfo.py",
        "capture/__init__.py",
        "capture/device.py",
        "capture/messages.py",
        "capture/pod_capture.py",
        "capture/role.py",
        "config_table.py",
        "data.py",
        "labconfig.py",
        "pinned.py",
        "place.py",
        "roles.py",
        "rundir.py",
        "runner.py",
        "script.py",
    ],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = ["@rules_python//python/runfiles"],
)

# The runner: `bazel run //brenn_lab:lab -- dry-run|run ...`. It carries the
# pinned recorder, which a machine's `pod_capture = { pinned = true }` names.
py_binary(
    name = "lab",
    srcs = ["cli.py"],
    data = [
        "//tools/brenn_pod:pod-capture",
        "//tools/buildinfo:build_info",
    ],
    main = "cli.py",
    visibility = ["//visibility:public"],
    deps = [
        ":brenn_lab",
        "@rules_python//python/runfiles",
    ],
)

py_pytest_test(
    name = "pinned_test",
    size = "small",
    srcs = ["pinned_test.py"],
    data = ["//tools/brenn_pod:pod-capture"],
    deps = [":brenn_lab"],
)

py_pytest_test(
    name = "cli_test",
    size = "small",
    srcs = ["cli_test.py"],
    data = [
        ":lab",
        "//brenn_lab/testing:stand_in",
    ],
    env = {
        "LAB": "$(rootpath :lab)",
        "STAND_IN": "$(rootpath //brenn_lab/testing:stand_in)",
    },
    deps = [
        ":brenn_lab",
        "//brenn_lab/testing:lab_driver",
    ],
)

py_pytest_test(
    name = "buildinfo_test",
    size = "small",
    srcs = ["buildinfo_test.py"],
    deps = [":brenn_lab"],
)

py_pytest_test(
    name = "runner_test",
    size = "small",
    srcs = ["runner_test.py"],
    data = [
        "//brenn_lab/testing:stand_in",
        "//examples:ten_seconds.py",
    ],
    env = {
        "EXAMPLE": "$(rootpath //examples:ten_seconds.py)",
        "STAND_IN": "$(rootpath //brenn_lab/testing:stand_in)",
    },
    deps = [
        ":brenn_lab",
        "//brenn_lab/testing:transcript_files",
    ],
)

py_pytest_test(
    name = "capture_role_test",
    size = "small",
    srcs = ["capture/role_test.py"],
    data = ["//brenn_lab/testing:stand_in"],
    env = {
        "STAND_IN": "$(rootpath //brenn_lab/testing:stand_in)",
    },
    deps = [
        ":brenn_lab",
        "//brenn_lab/testing:transcript_files",
    ],
)

# The hardware lane: the capture role on an attached reSpeaker Flex XVF3800,
# six-channel USB image, through the pinned recorder and reader. The recorder
# loads the host's ALSA runtime library, so this test needs it; nothing in the
# default check runs the recorder.
# TODO(lanes-load-host-alsa-runtime)
# The Flex has one opener and Bazel runs test targets in parallel, so this is
# the only target that opens the Flex: another test that opens it is added to
# this target, or that target and this one are both tagged `exclusive`.
py_pytest_test(
    name = "capture_flex_hardware_test",
    size = "small",
    timeout = "moderate",
    srcs = ["capture/flex_hardware_test.py"],
    data = [
        ":lab",
        "//examples:ten_seconds.py",
        "//tools/brenn_pod:frame-log",
    ],
    env = {
        "EXAMPLE": "$(rootpath //examples:ten_seconds.py)",
        "FRAME_LOG": "$(rootpath //tools/brenn_pod:frame-log)",
        "LAB": "$(rootpath :lab)",
    },
    tags = [
        "external",
        "hardware",
    ],
    deps = [
        ":brenn_lab",
        "//brenn_lab/testing:lab_driver",
        "//brenn_lab/testing:transcript_files",
    ],
)

py_pytest_test(
    name = "transcripts_test",
    size = "small",
    srcs = ["capture/transcripts_test.py"],
    deps = [
        ":brenn_lab",
        "//brenn_lab/testing:transcript_files",
    ],
)

py_pytest_test(
    name = "data_test",
    size = "small",
    srcs = ["data_test.py"],
    deps = [":brenn_lab"],
)

py_pytest_test(
    name = "labconfig_test",
    size = "small",
    srcs = ["labconfig_test.py"],
    deps = [":brenn_lab"],
)
