load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/pytest:defs.bzl", "py_pytest_test")

# Every source is listed by name, with no glob: a new file reaches a target
# only through a tracked change to this file.

py_library(
    name = "brenn_lab",
    srcs = [
        "__init__.py",
        "account.py",
        "buildinfo.py",
        "capture/__init__.py",
        "capture/account.py",
        "capture/device.py",
        "capture/messages.py",
        "capture/pod_capture.py",
        "capture/role.py",
        "config_table.py",
        "data.py",
        "labconfig.py",
        "pinned.py",
        "place.py",
        "playback/__init__.py",
        "playback/account.py",
        "playback/alsa.py",
        "playback/device.py",
        "playback/limits.py",
        "playback/messages.py",
        "playback/output.py",
        "playback/role.py",
        "playback/source.py",
        "roles.py",
        "rundir.py",
        "runner.py",
        "script.py",
        "sound.py",
    ],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = ["@rules_python//python/runfiles"],
)

# The runner: `bazel run //brenn_lab:lab -- dry-run|run ...`. It carries the
# pinned recorder, which a machine's `pod_capture = { pinned = true }` names.
py_binary(
    name = "lab",
    srcs = ["cli.py"],
    data = [
        "//tools/brenn_pod:pod-capture",
        "//tools/buildinfo:build_info",
    ],
    main = "cli.py",
    visibility = ["//visibility:public"],
    deps = [
        ":brenn_lab",
        "@rules_python//python/runfiles",
    ],
)

