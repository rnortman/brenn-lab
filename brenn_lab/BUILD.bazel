# The hardware lane: the capture role on an attached reSpeaker Flex XVF3800,
# six-channel USB image, through the pinned recorder and reader. The recorder
# loads the host's ALSA runtime library, so this test needs it; nothing in the
# default check runs the recorder.
# TODO(lanes-load-host-alsa-runtime)
# The Flex has one opener and Bazel runs test targets in parallel, so this is
# the only target in its lane that opens a PCM of the Flex: another test in the
# lane that opens one is added to this target, or that target and this one are
# both tagged `exclusive`.
py_pytest_test(
    name = "capture_flex_hardware_test",
    size = "small",
    timeout = "moderate",
    srcs = ["capture/flex_hardware_test.py"],
    data = [
        ":lab",
        "//examples:ten_seconds.py",
        "//tools/brenn_pod:frame-log",
    ],
    env = {
        "EXAMPLE": "$(rootpath //examples:ten_seconds.py)",
        "FRAME_LOG": "$(rootpath //tools/brenn_pod:frame-log)",
        "LAB": "$(rootpath :lab)",
    },
    tags = [
        "external",
        "hardware",
    ],
    deps = [
        ":brenn_lab",
        "//brenn_lab/testing:lab_driver",
        "//brenn_lab/testing:transcript_files",
    ],
)

# The audible lane: the playback role on an attached reSpeaker Flex XVF3800
# with a speaker on its output, while the capture role records it, through the
# runner as a program and the pinned recorder and reader. It plays sound, so
# it runs only inside a window the maintainer agreed. The runner's playback
# role and the recorder load the host's ALSA runtime library.
# TODO(lanes-load-host-alsa-runtime)
# The Flex has one opener and Bazel runs test targets in parallel, so this is
# the only target in its lane that opens a PCM of the Flex: another test in the
# lane that opens one is added to this target, or that target and this one are
# both tagged `exclusive`.
py_pytest_test(
    name = "playback_flex_audible_test",
    size = "small",
    timeout = "moderate",
    srcs = ["playback/flex_audible_test.py"],
    data = [
        ":lab",
        "//tools/brenn_pod:frame-log",
    ],
    env = {
        "FRAME_LOG": "$(rootpath //tools/brenn_pod:frame-log)",
        "LAB": "$(rootpath :lab)",
    },
    tags = [
        "audible",
        "external",
    ],
    deps = [
        ":brenn_lab",
        "//brenn_lab/testing:lab_driver",
        "//brenn_lab/testing:signals",
    ],
)

# The hardware lane: the playback role's ALSA module on the host's ALSA
