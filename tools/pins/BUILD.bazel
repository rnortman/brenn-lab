load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Holds two pins: the Python version, which lives in four files, equal; and
# every use of the brenn-pod commit, the transcripts' README included, to the
# one constant in MODULE.bazel.
sh_test(
    name = "pins_test",
    size = "small",
    srcs = ["pins_test.sh"],
    data = [
        "//:MODULE.bazel",
        "//:mypy.ini",
        "//:ruff.toml",
        "//brenn_lab/testing:transcripts/README.md",
        "//tools/mypy:BUILD.bazel",
    ],
    env = {
        "MODULE_BAZEL": "$(rlocationpath //:MODULE.bazel)",
        "MYPY_BUILD": "$(rlocationpath //tools/mypy:BUILD.bazel)",
        "MYPY_INI": "$(rlocationpath //:mypy.ini)",
        "RUFF_TOML": "$(rlocationpath //:ruff.toml)",
        "TRANSCRIPTS_README": "$(rlocationpath //brenn_lab/testing:transcripts/README.md)",
    },
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
