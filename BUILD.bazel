# A dependant loads this package to read `requirements.in`, so nothing in it
# may load a dev-dependency repository: one that is absent when this module is
# not the root fails the whole package. The gate's buildifier targets live in
# //tools/buildifier for that reason.
load("@rules_python//python/uv:lock.bzl", "lock")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files([
    "MODULE.bazel",
    "mypy.ini",
    "requirements.in",
    "ruff.toml",
])

# `bazel run //:requirements.update` rewrites requirements_lock.txt from
# requirements.in, with the pinned uv and the hermetic interpreter. The lock
# action carries `requires-network` and `manual` itself, so it is the one
# action that reaches the network and `bazel test //...` never runs it.
lock(
    name = "requirements",
    srcs = ["requirements.in"],
    out = "requirements_lock.txt",
    args = ["--universal"],
)

# Python format and lint over every Python file in the working tree, including
# files no target owns. Unsandboxed for the same reason as
# //tools/buildifier:buildifier_test.
sh_test(
    name = "ruff_test",
    size = "small",
    srcs = ["//tools/ruff:ruff_check.sh"],
    args = [
        "$(rootpath //tools/ruff)",
        "$(rootpath //:MODULE.bazel)",
    ],
    data = [
        "//:MODULE.bazel",
        "//tools/ruff",
    ],
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
)
